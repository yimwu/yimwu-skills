# Environment Variables

# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Application Settings
APP_NAME={project_name}
APP_VERSION=0.1.0
APP_ENV=development

# Database (if applicable)
DB_HOST=localhost
DB_PORT=5432
DB_NAME={project_name}
DB_USER=postgres
DB_PASSWORD=changeme

# API Keys (get from respective services)
API_KEY_1=your_api_key_here
API_KEY_2=your_api_key_here

# External Services
EXTERNAL_SERVICE_URL=https://api.example.com
EXTERNAL_SERVICE_KEY=your_service_key

# Feature Flags
FEATURE_NEW_UI=false
FEATURE_EXPERIMENTAL=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Testing
TEST_DB_NAME={project_name}_test
TEST_API_KEY=test_api_key

# Development
DEBUG=false
HOT_RELOAD=true

# Production (DO NOT set these in .env, use CI/CD secrets)
# SECRET_KEY=...
# DATABASE_URL=...
# PRODUCTION_API_KEY=...
